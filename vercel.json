{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "headers": [
    {
      "source": "/datasheets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/en",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/en",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/indexnow",
      "schedule": "30 5 * * 1"
    },
    {
      "path": "/api/indexnow?scope=recent",
      "schedule": "40 6 * * *"
    }
  ],
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)data'"
}
