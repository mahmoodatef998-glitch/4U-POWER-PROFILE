# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://www.4ugenerators.com

# ---- Supabase (Project Settings -> API) ----
# Without these the site runs on the bundled seed content and leads are only logged to the server console.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY - never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# ---- Analytics (leave empty until accounts exist; everything no-ops) ----
# GA4: production defaults to G-S9RNFB5JTL; set only to override
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ---- Lead email notifications via Resend (optional) ----
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
LEAD_FROM_EMAIL=leads@4ugenerators.com

# ---- /admin basic auth (required to enable /admin) ----
ADMIN_USER=
ADMIN_PASSWORD=

# ---- Preview only: show placeholder testimonials (never enable in production) ----
NEXT_PUBLIC_SHOW_PLACEHOLDER_TESTIMONIALS=
